<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.StatusCatch" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
    <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

    <item name="fontFamily">@font/helvetice_regular</item>
    <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TabText">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="BottomNavStyle">
        <item name="colorSecondaryContainer">@color/colorPrimaryHighlight</item>
    </style>
    <style name="Theme.StatusCatch" parent="Base.Theme.StatusCatch" />
    <style name="TabTitleStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="TabCountStyle">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#B3FFFFFF</item> <!-- white with 70% alpha -->
    </style>
</resources>